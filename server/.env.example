# Copy this file to .env and adjust as needed. Both are optional — the server runs with sane
# defaults (PORT=3001, server/data/app.db) if no .env file is present at all.

# Port the Express server listens on.
PORT=3001

# Path to the SQLite database file. Relative paths resolve from the server/ directory.
# Leave unset to use the default: server/data/app.db
# DATABASE_PATH=./data/app.db
